# Copie para .env (o iniciar.bat faz isso sozinho). Nunca versione o arquivo preenchido.

# --- Obrigatórias ---
# Chave da Anthropic (Claude).
ANTHROPIC_API_KEY=
# Chave da Judit.
JUDIT_API_KEY=

# --- Opcionais ---
# Modelo do Claude (padrão: claude-sonnet-5-5).
RESUMO_MODELO=claude-sonnet-5-5
# Só para scripts/gerar_datajud.py (chave pública do DataJud).
DATAJUD_API_KEY=
# Senha de acesso da tela. Dispensável no uso local; obrigatória em servidor.
# APP_SENHA=
# Endereço e porta da tela (padrão: 127.0.0.1 e 8000). Em servidor use HOST=0.0.0.0.
# HOST=127.0.0.1
# PORT=8000
# Pasta onde os resumos e a auditoria são guardados (padrão: dados/ no projeto).
# RESUMO_DADOS_DIR=
# URL pública do webhook da Judit, só para quem usa scripts/servidor_webhook.py. Use a URL real.
# JUDIT_CALLBACK_URL=
